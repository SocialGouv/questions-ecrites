## API keys
export ALBERT_API_KEY="<albert_api_key>"

## Albert API configuration (embeddings + reranking)
# ALBERT_EMBEDDINGS_URL defaults to {ALBERT_BASE_URL}/v1/embeddings when unset.
export ALBERT_BASE_URL="https://albert.api.etalab.gouv.fr"
export ALBERT_RERANK_MODEL="openweight-rerank"
export ALBERT_EMBEDDING_MODEL="BAAI/bge-m3"

## Postgres connection
export DATABASE_URL="<database_url>"
