## API keys
export PLIAGE_API_KEY="<pliage_api_key>"
export ALBERT_API_KEY="<albert_api_key>"

## Socle IA / LLM configuration
# LLM_BASE_URL is required. CHAT_COMPLETIONS_URL and EMBEDDINGS_URL are
# derived automatically when not set:
#   CHAT_COMPLETIONS_URL = {LLM_BASE_URL}/api/v1/chat/completions
#   EMBEDDINGS_URL       = {LLM_BASE_URL}/api/embeddings
export LLM_BASE_URL="https://ia.social.gouv.fr"
export LLM_MODEL="openai/gpt-oss-120b"
export EMBEDDING_MODEL="BAAI/bge-m3"

## Postgres connection
export DATABASE_URL="<database_url>"
